# ── Simulateur de logs CTU-SIEM ─────────────────────────────────────────────
BACKEND_URL=http://localhost:8080
LOG_RATE=1
LOG_TYPES=application,system,auth,network
ANOMALY_RATE=0.2

# ── Elasticsearch ────────────────────────────────────────────────────────────
ES_HOST=https://localhost:9200
ES_USER=elastic
ES_PASSWORD=changeme
ES_VERIFY_CERTS=false
ES_INDEX=siem-logs

# ── PostgreSQL ───────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=smart_siem
PG_USER=postgres
PG_PASSWORD=changeme

# ── Modèle UEBA ─────────────────────────────────────────────────────────────
ISOLATION_FOREST_CONTAMINATION=0.05
ISOLATION_FOREST_N_ESTIMATORS=200
RANDOM_STATE=42
ANOMALY_SCORE_THRESHOLD=0.0
EXTRACTION_WINDOW_MINUTES=15
BATCH_SIZE=5000
BASELINE_CSV_PATH=data/1_baseline/BENIGN.csv

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
